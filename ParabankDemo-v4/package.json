{
  "name": "parabank-qa-automation-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Browser and REST API tests for ParaBank customer banking workflows",
  "scripts": {
    "test:unit": "node -r ts-node/register --test tests/**/*.test.ts",
    "test:api": "cucumber-js --config cucumber.v4.js --tags \"@api\"",
    "test:smoke": "cucumber-js --config cucumber.v4.js --tags \"@smoke and not @api\"",
    "test:regression": "cucumber-js --config cucumber.v4.js --tags \"@regression and not @known-bug\"",
    "test:known-bugs": "cucumber-js --config cucumber.v4.js --tags \"@known-bug\"",
    "test:feature:login": "cucumber-js --config cucumber.v4.js features/login.feature",
    "test:security": "cucumber-js --config cucumber.v4.js --tags \"@security\"",
    "test:tags": "cucumber-js --config cucumber.v4.js",
    "test:dry-run": "cucumber-js --config cucumber.v4.js --dry-run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests README.md",
    "format": "prettier --write src tests README.md",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose stop"
  },
  "devDependencies": {
    "@cucumber/cucumber": "10.9.0",
    "@eslint/js": "8.57.1",
    "@playwright/test": "1.60.0",
    "@types/node": "20.19.13",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  }
}
